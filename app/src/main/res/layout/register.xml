<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_screen" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="EBONE" android:textColor="@color/ebone_blue" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Dealer Registration" android:textColor="@color/ebone_text" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="اپنے جاری کردہ Dealer Code سے اس موبائل کو رجسٹر کریں۔" android:textColor="@color/ebone_muted" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <EditText android:id="@+id/n" android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_input" android:hint="Dealer Name" android:paddingHorizontal="14dp" />
            <EditText android:id="@+id/m" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="Mobile Number" android:inputType="phone" android:paddingHorizontal="14dp" />
            <EditText android:id="@+id/c" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="6-Digit Dealer Code" android:inputType="number" android:maxLength="6" android:paddingHorizontal="14dp" />
            <Button android:id="@+id/go" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="18dp" android:background="@drawable/bg_primary" android:text="REGISTER DEVICE" android:textColor="@color/ebone_white" android:textStyle="bold" />
            <TextView android:id="@+id/s" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="#C62828" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
