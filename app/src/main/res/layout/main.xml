<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ebone_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Compact header: designed to fit one normal phone screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="215dp"
        android:background="@drawable/bg_primary"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/menuButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:text="☰" android:textColor="@color/ebone_white" android:textSize="31sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EBONE DEALER" android:textColor="@color/ebone_white" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="♧" android:textColor="@color/ebone_white" android:textSize="24sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Dealer"
            android:textColor="@color/ebone_white"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="81dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AVAILABLE BALANCE" android:textColor="@color/ebone_muted" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/totalBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Rs. 0" android:textColor="@color/ebone_primary" android:textSize="28sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:layout_width="44dp" android:layout_height="39dp" android:background="@drawable/bg_soft_purple" android:gravity="center" android:text="▣" android:textColor="@color/ebone_primary" android:textSize="20sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ISP balances -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_wateen" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WATEEN" android:textColor="@color/ebone_blue" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Balance" android:textColor="@color/ebone_text" android:textSize="13sp"/>
            <TextView android:id="@+id/w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_blue" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="View Details  ›" android:textColor="@color/ebone_blue" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/bg_ebone" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EBONE" android:textColor="@color/ebone_green" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Balance" android:textColor="@color/ebone_text" android:textSize="13sp"/>
            <TextView android:id="@+id/e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_green" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="View Details  ›" android:textColor="@color/ebone_green" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_zong" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZONG 4G" android:textColor="@color/ebone_pink" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Balance" android:textColor="@color/ebone_text" android:textSize="13sp"/>
            <TextView android:id="@+id/z" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_pink" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="View Details  ›" android:textColor="@color/ebone_pink" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- New payment -->
    <LinearLayout
        android:id="@+id/pay"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_primary"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">
        <TextView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_card" android:gravity="center" android:text="▣" android:textColor="@color/ebone_primary" android:textSize="19sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEW PAYMENT" android:textColor="@color/ebone_white" android:textSize="23sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add payment &amp; upload screenshot" android:textColor="#E9E7FF" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:layout_width="36dp" android:layout_height="35dp" android:background="@drawable/bg_card" android:gravity="center" android:text="›" android:textColor="@color/ebone_primary" android:textSize="35sp"/>
    </LinearLayout>

    <!-- Payment summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PAYMENT SUMMARY" android:textColor="@color/ebone_text" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This Week ⌄" android:textColor="@color/ebone_muted" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="63dp" android:layout_marginTop="4dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_soft_blue" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENDING" android:textColor="@color/ebone_blue" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ebone_blue" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_blue" android:textSize="8sp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/bg_soft_green" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VERIFIED" android:textColor="@color/ebone_green" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ebone_green" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_green" android:textSize="8sp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/bg_soft_orange" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REJECTED" android:textColor="@color/ebone_orange" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ebone_orange" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_orange" android:textSize="8sp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_soft_purple" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COLLECTED" android:textColor="@color/ebone_primary" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0" android:textColor="@color/ebone_primary" android:textSize="15sp" android:textStyle="bold"/></LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Receiving accounts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RECEIVING ACCOUNTS" android:textColor="@color/ebone_text" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manage  ›" android:textColor="@color/ebone_primary" android:textSize="11sp"/></LinearLayout>
        <TextView android:id="@+id/methods" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/bg_soft_gray" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Receiving accounts will appear here." android:textColor="@color/ebone_text" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="33dp" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_soft_green" android:gravity="center_vertical" android:paddingStart="8dp" android:text="Jazz Till ID   ON / OFF" android:textColor="@color/ebone_text" android:textSize="10sp"/>
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_soft_blue" android:gravity="center_vertical" android:paddingStart="8dp" android:text="EasyPaisa   ON / OFF" android:textColor="@color/ebone_text" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation; icons enlarged only, labels unchanged -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_primary"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="@color/ebone_white"
                android:textSize="23sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="@color/ebone_white"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="#DCD8FF"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Payment"
                android:textColor="#DCD8FF"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="◷"
                android:textColor="#DCD8FF"
                android:textSize="31sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="#DCD8FF"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="▥"
                android:textColor="#DCD8FF"
                android:textSize="23sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textColor="#DCD8FF"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="♙"
                android:textColor="#DCD8FF"
                android:textSize="23sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#DCD8FF"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout></LinearLayout>